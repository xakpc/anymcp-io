{
  "name": "anymcp-io",
  "version": "1.0.0",
  "scripts": {
    "build": "eleventy",
    "serve": "eleventy --serve",
    "start": "eleventy --serve",
    "debug": "DEBUG=Eleventy* eleventy",
    "deploy": "npm run build && wrangler pages deploy _site",
    "test": "node scripts/run-tests.js",
    "test:lint": "node scripts/run-tests.js --layer lint",
    "test:site": "node scripts/run-tests.js --layer site",
    "test:build": "node scripts/run-tests.js --layer build",
    "test:protocol": "node scripts/run-tests.js --layer protocol",
    "test:list": "node scripts/run-tests.js --list"
  },
  "description": "A catalog of single-file MCP servers for .NET 10. Works with any LLM that supports local connections.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xakpc/anymcp-io.git"
  },
  "keywords": [
    "mcp",
    "dotnet",
    "servers",
    "ai",
    "llm"
  ],
  "author": "AnyMCP Team",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/xakpc/anymcp-io/issues"
  },
  "homepage": "https://github.com/xakpc/anymcp-io#readme",
  "dependencies": {
    "@11ty/eleventy": "^3.1.6",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "wrangler": "^4.124.0"
  }
}
