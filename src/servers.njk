---
pagination:
  data: serversArray
  size: 1
  alias: serverData
permalink: "/servers/{{ serverData.id }}/"
layout: page.njk
showBadges: false
showNavigation: false
eleventyComputed:
  title: "{{ serverData.name }}"
  description: "{{ serverData.description }}"
  agentMarkdown: "/servers/{{ serverData.id }}/index.md"
---

<div class="container mx-auto px-4 py-8 max-w-6xl">
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <!-- Main Content -->
    <div class="lg:col-span-2 space-y-6">
      <!-- Server Info -->
      <div>
        <div class="flex items-start justify-between mb-4">
          <div>
            <h1 class="text-3xl font-bold mb-2">{{ serverData.name }}</h1>
            {% if serverData.longDescription %}
            <p class="text-lg text-muted-foreground mb-4">{{ serverData.longDescription }}</p>
            {% else %}
            <p class="text-lg text-muted-foreground mb-4">{{ serverData.description }}</p>
            {% endif %}
          </div>
          {% if serverData.status and serverData.status != 'stable' %}
          <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-medium
            {% if serverData.status == 'beta' %}bg-yellow-100 text-yellow-800 border border-yellow-200{% endif %}
            {% if serverData.status == 'alpha' %}bg-red-100 text-red-800 border border-red-200{% endif %}">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z"></path>
            </svg>
            {{ serverData.status }}
          </span>
          {% endif %}
        </div>

        <div class="flex flex-wrap gap-2 mb-6">
          {% for tag in serverData.tags %}
            <span class="inline-flex items-center px-2.5 py-1 text-xs font-medium bg-secondary text-secondary-foreground rounded-md">
              {{ tag }}
            </span>
          {% endfor %}
        </div>

        <div class="flex gap-3">
          {#- The main action of the page. The line goes to a coding agent, which reads
              /servers/{id}/index.md and does the installation. The agentPrompt filter in
              .eleventy.js holds the text, because a catalog card writes the same line.
              No "| safe" here: the value goes into HTML, Nunjucks escapes it, and
              dataset.prompt decodes it again. -#}
          <button type="button" onclick="copyPrompt(this)" data-prompt="{{ serverData.id | agentPrompt(site.url) }}" class="inline-flex items-center px-4 py-2 bg-primary text-primary-foreground rounded-md hover:bg-primary/90 transition-colors">
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
            </svg>
            Copy Agent Prompt
          </button>
          <button onclick="copyServerCodeLarge('{{ serverData.id }}', '{{ serverData.name }}', this)" class="inline-flex items-center px-4 py-2 bg-transparent border border-border rounded-md hover:bg-accent hover:text-accent-foreground transition-colors">
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
            </svg>
            Copy Code
          </button>
          <button onclick="downloadServerFile('{{ serverData.id }}', '{{ serverData.name }}', this)" class="inline-flex items-center px-4 py-2 bg-transparent border border-border rounded-md hover:bg-accent hover:text-accent-foreground transition-colors">
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
            Download File
          </button>
          <a href="{{ site.github }}/blob/main/mcp/{{ serverData.name }}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center px-4 py-2 bg-transparent border border-border rounded-md hover:bg-accent hover:text-accent-foreground transition-colors">
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
            </svg>
            View on GitHub
          </a>
        </div>
      </div>

      <div class="border-t border-border"></div>

      <!-- Available Tools -->
      {% if serverData.tools and serverData.tools.length > 0 %}
      <div>
        <h2 class="text-2xl font-bold mb-4 flex items-center gap-2">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
          </svg>
          Available Tools
        </h2>
        <div class="grid gap-4">
          {% for tool in serverData.tools %}
          <div class="bg-card border border-border rounded-lg p-4">
            <div class="flex items-start gap-3">
              <div class="w-8 h-8 bg-primary/10 rounded-lg flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                </svg>
              </div>
              <div class="flex-1 min-w-0">
                <h3 class="font-semibold text-base mb-2">{{ tool.name }}</h3>
                <p class="text-sm text-muted-foreground leading-relaxed">{{ tool.description }}</p>
              </div>
            </div>
          </div>
          {% endfor %}
        </div>
      </div>

      <div class="border-t border-border"></div>
      {% endif %}

      <!-- Code Viewer -->
      {% if serverData.code %}
      <div>
        <h2 class="text-2xl font-bold mb-4 flex items-center gap-2">
          <svg class="w-6 h-6 text-gray-800" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m8 8-4 4 4 4m8 0 4-4-4-4m-2-3-4 14"/>
          </svg>
          Source Code
        </h2>
        {#- The block shows the first 20 lines, and the button below opens the rest. The clip is
            a max-height on the wrapper, and never display:none, so the whole file stays in the
            DOM: copyServerCode(), downloadServerFile(), and test/site.test.js all read
            #server-code.textContent while the block is closed. -#}
        {%- set codeLines = serverData.displayCode | lineCount %}
        {%- set clipped = codeLines > 28 %}
        <div class="relative">
          <div id="server-code-wrap" data-open="false"{% if clipped %} style="max-height: 28rem; overflow: hidden;"{% endif %}>
            {#- No "| safe" here. The code holds "<" characters, in generics and in the /// <summary>
                doc comments, and raw output makes the browser read them as tags: the text disappears
                from the page and from textContent. Autoescape writes the entities, the reader sees the
                source, and the copy buttons read this one block. -#}
            <pre class="language-csharp"><code class="language-csharp" id="server-code" data-server-id="{{ serverData.id }}">{{ serverData.displayCode }}</code></pre>
            {%- if clipped %}
            {#- The fade sits after </pre>, and never inside <code>: the test takes the block text
                up to the first </code>. #011627 is the Night Owl background in base.njk. -#}
            <div id="server-code-fade" class="pointer-events-none absolute inset-x-0 bottom-0 h-24" style="background: linear-gradient(to top, #011627, rgba(1, 22, 39, 0));"></div>
            {%- endif %}
          </div>
          <button onclick="copyServerCode('{{ serverData.id }}', '{{ serverData.name }}', this)" class="absolute top-3 right-3 inline-flex items-center px-3 py-1.5 text-xs font-medium bg-slate-700 text-slate-100 rounded hover:bg-slate-600 transition-colors">
            <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
            </svg>
            Copy
          </button>
        </div>
        {%- if clipped %}
        <button type="button" id="server-code-toggle" onclick="toggleServerCode(this)" data-lines="{{ codeLines }}" data-collapsed="28rem" class="mt-3 inline-flex items-center px-3 py-1.5 text-sm font-medium bg-transparent border border-border rounded-md hover:bg-accent hover:text-accent-foreground transition-colors">
          Show all {{ codeLines }} lines
        </button>
        {%- endif %}
      </div>

      <div class="border-t border-border"></div>
      {% endif %}

      <!-- Run Instructions -->
      <div>
        <h2 class="text-2xl font-bold mb-4 flex items-center gap-2">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h1.586a1 1 0 01.707.293L12 11l.707-.707A1 1 0 0113.414 10H15M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          How to Run
        </h2>
        <div class="bg-card border border-border rounded-lg p-6">
          <div class="space-y-4">
            <div>
              <h4 class="font-semibold mb-2">1. Save the server code</h4>
              <p class="text-sm text-muted-foreground">Put it in your project, in a <code class="bg-muted px-1 py-0.5 rounded text-xs">.mcp-servers/</code> directory. Copy the code above, or download it from <a href="/servers/{{ serverData.id }}/{{ serverData.name }}" class="underline hover:text-foreground">/servers/{{ serverData.id }}/{{ serverData.name }}</a>. Commit it: the file is the whole server.</p>
            </div>
            <div>
              <h4 class="font-semibold mb-2">2. Build it once</h4>
              <p class="text-sm text-muted-foreground mb-2">The first build restores the packages. It takes longer than the startup timeout of most clients, so run it by hand before you go on:</p>
<pre class="language-bash"><code class="language-bash">dotnet build .mcp-servers/{{ serverData.name }} -v q</code></pre>
              <p class="text-sm text-muted-foreground mt-2">This adds no <code class="bg-muted px-1 py-0.5 rounded text-xs">bin</code> or <code class="bg-muted px-1 py-0.5 rounded text-xs">obj</code> directory to your project. A file-based app is not a project, so the SDK caches the build under your temp directory instead. Your <code class="bg-muted px-1 py-0.5 rounded text-xs">.gitignore</code> needs no new line.</p>
            </div>
            <div>
              <h4 class="font-semibold mb-2">3. Configure your MCP client</h4>
              <p class="text-sm text-muted-foreground mb-3">Claude Code and Codex read different files, in different formats. Pick yours, add the snippet to your project root, and commit it. Everyone who clones the project then gets the server. Don't paste one client's format into the other's file.</p>

              <p class="text-sm font-medium mb-2">Claude Code — <code class="bg-muted px-1 py-0.5 rounded text-xs">.mcp.json</code></p>
              <div class="bg-blue-50 border border-blue-200 rounded-lg p-3 mb-3">
                <p class="text-sm text-blue-800">
                  <strong>Note:</strong> This example also covers Claude Desktop, Cursor, and Windsurf. Visual Studio and VS Code use <code class="bg-blue-100 px-1 py-0.5 rounded text-xs">servers</code> instead of <code class="bg-blue-100 px-1 py-0.5 rounded text-xs">mcpServers</code>.
                </p>
              </div>
<pre class="language-json"><code class="language-json">{
  "mcpServers": {
    "{{ serverData.id }}": {
      "type": "stdio",
      "command": "dotnet",
      "args": ["run", "./.mcp-servers/{{ serverData.name }}", "-v", "q"]{% if serverData.envVars and serverData.envVars.length > 0 %},
      "env": {
        {%- for envVar in serverData.envVars %}
        "{{ envVar }}": "${{ "{" }}{{ envVar }}{{ "}" }}"{%- if not loop.last %},{% endif %}
        {%- endfor %}
      }{% endif %}
    }
  }
}</code></pre>
              {%- if serverData.envVars and serverData.envVars.length > 0 %}
              <p class="text-sm text-muted-foreground mt-2">Because this file is committed, it names the variable and never holds the value. Claude Code expands <code class="bg-muted px-1 py-0.5 rounded text-xs">${...}</code> from your environment when it reads the file.</p>
              {%- endif %}
              <p class="text-sm text-muted-foreground mt-2 mb-4"><code class="bg-muted px-1 py-0.5 rounded text-xs">claude mcp add {{ serverData.id }} --scope project -- dotnet run ./.mcp-servers/{{ serverData.name }} -v q</code> writes the same entry for you. Full details: <a href="/install/claude-code.md" class="underline hover:text-foreground">/install/claude-code.md</a>.</p>

              <p class="text-sm font-medium mb-2">Codex — <code class="bg-muted px-1 py-0.5 rounded text-xs">.codex/config.toml</code></p>
<pre class="language-toml"><code class="language-toml">[mcp_servers.{{ serverData.id }}]
command = "dotnet"
args = [
    "run",
    "./.mcp-servers/{{ serverData.name }}",
    "-v",
    "q",
]
{% if serverData.envVars and serverData.envVars.length > 0 %}env_vars = [{% for envVar in serverData.envVars %}"{{ envVar }}"{% if not loop.last %}, {% endif %}{% endfor %}]
{% endif %}startup_timeout_sec = 60</code></pre>
              <div class="bg-amber-50 border border-amber-200 rounded-lg p-3 mt-3">
                <p class="text-sm text-amber-900">
                  <strong>Codex needs the project trusted.</strong> It ignores a project <code class="bg-amber-100 px-1 py-0.5 rounded text-xs">.codex/config.toml</code> unless your personal <code class="bg-amber-100 px-1 py-0.5 rounded text-xs">~/.codex/config.toml</code> holds <code class="bg-amber-100 px-1 py-0.5 rounded text-xs">[projects.'&lt;absolute path&gt;']</code> with <code class="bg-amber-100 px-1 py-0.5 rounded text-xs">trust_level = "trusted"</code> — and there is no error message when it doesn't. On Windows use the plain <code class="bg-amber-100 px-1 py-0.5 rounded text-xs">C:\Users\...</code> path, never the extended <code class="bg-amber-100 px-1 py-0.5 rounded text-xs">\\?\C:\...</code> form. Don't commit that entry. See <a href="/install/codex.md" class="underline hover:text-amber-950">/install/codex.md</a>.
                </p>
              </div>
              {%- if serverData.envVars and serverData.envVars.length > 0 %}
              <p class="text-sm text-muted-foreground mt-2">Codex does not expand <code class="bg-muted px-1 py-0.5 rounded text-xs">${...}</code>. Its <code class="bg-muted px-1 py-0.5 rounded text-xs">env</code> table takes literal values, so <code class="bg-muted px-1 py-0.5 rounded text-xs">env_vars</code> names the variable and Codex forwards the value from its own environment.</p>
              {%- endif %}
              <p class="text-sm text-muted-foreground mt-2">Both paths are relative to the project, so they work for everyone who clones it, on every operating system. <code class="bg-muted px-1 py-0.5 rounded text-xs">-v q</code> is required in both: standard output carries the JSON-RPC stream, and without it the build output can reach that stream and break the connection.</p>
            </div>
            <div>
              <h4 class="font-semibold mb-2">4. Restart your LLM client</h4>
              <p class="text-sm text-muted-foreground">Restart your client in the project directory, then check that {{ serverData.id }} shows as connected. Claude Code asks you to approve a project server the first time it reads <code class="bg-muted px-1 py-0.5 rounded text-xs">.mcp.json</code>. Codex reads its configuration at startup only, so restart it <em>and</em> open a new chat.</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Sidebar -->
    <div class="space-y-6">
      <!-- Stats Card -->
      {% if serverData.downloads or serverData.version or serverData.license or serverData.lastUpdated %}
      <div class="bg-card border border-border rounded-lg p-6">
        <h3 class="text-lg font-semibold mb-4">Statistics</h3>
        <div class="space-y-4">
          {% if serverData.downloads and serverData.downloads > 0 %}
          <div class="flex justify-between">
            <span class="text-muted-foreground">Downloads</span>
            <span class="font-medium">{{ serverData.downloads | localeString }}</span>
          </div>
          {% endif %}
          {% if serverData.version %}
          <div class="flex justify-between">
            <span class="text-muted-foreground">Version</span>
            <span class="font-medium">{{ serverData.version }}</span>
          </div>
          {% endif %}
          {% if serverData.license %}
          <div class="flex justify-between">
            <span class="text-muted-foreground">License</span>
            <span class="font-medium">{{ serverData.license }}</span>
          </div>
          {% endif %}
          {% if serverData.lastUpdated %}
          <div class="flex justify-between">
            <span class="text-muted-foreground">Updated</span>
            <span class="font-medium">{{ serverData.lastUpdated | date("M/D/YYYY") }}</span>
          </div>
          {% endif %}
        </div>
      </div>
      {% endif %}

      <!-- Environment Variables -->
      {% if serverData.envVars and serverData.envVars.length > 0 %}
      <div class="bg-card border border-border rounded-lg p-6">
        <div class="mb-4">
          <h3 class="text-lg font-semibold flex items-center gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
            Environment Variables
          </h3>
          <p class="text-sm text-muted-foreground">Required configuration for this server</p>
        </div>
        <div class="space-y-3">
          {% for envVar in serverData.envVars %}
            <div class="space-y-1">
              <div class="flex items-center gap-2">
                <code class="text-sm bg-muted px-2 py-1 rounded font-mono">
                  {% if envVar.name %}{{ envVar.name }}{% else %}{{ envVar }}{% endif %}
                </code>
                {% if envVar.required %}
                <span class="inline-flex items-center px-1.5 py-0.5 rounded-full text-xs font-medium bg-destructive text-destructive-foreground">
                  Required
                </span>
                {% endif %}
              </div>
              {% if envVar.description %}
              <p class="text-sm text-muted-foreground">{{ envVar.description }}</p>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      </div>
      {% endif %}

      <!-- Author Info -->
      {% if serverData.author and serverData.author != 'Unknown' %}
      <div class="bg-card border border-border rounded-lg p-6">
        <h3 class="text-lg font-semibold mb-4">Author</h3>
        <p class="font-medium">{{ serverData.author }}</p>
        <p class="text-sm text-muted-foreground mt-1">Maintained by the AnyMCP community</p>
      </div>
      {% endif %}
    </div>
  </div>
</div>

{% include "footer.njk" %}

{% include "copy-functionality.njk" %}