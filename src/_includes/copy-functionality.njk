<script>
// The code of a server has exactly two sources, and no page carries the code of every
// server any more:
//   - a server page already shows the code, in <code id="server-code">. Reading that
//     block costs nothing and cannot drift from what the reader sees.
//   - anywhere else, the published file at /servers/{id}/{name} is fetched. That file is
//     byte-identical to the catalog file, so the front matter is stripped here.

// Drops every line through the second "// ---" line, then trims. This is the rule that
// extractCodeWithoutFrontMatter in src/_data/servers.js uses to build displayCode, so a
// fetched copy and a copy from the page are the same text.
function stripFrontMatter(text) {
  const lines = text.split('\n');
  let startFound = false;

  for (let i = 0; i < lines.length; i++) {
    if (lines[i].trim() !== '// ---') continue;
    if (!startFound) {
      startFound = true;
      continue;
    }
    return lines.slice(i + 1).join('\n').trim();
  }

  return text.trim();
}

async function serverCodeFor(serverId, fileName) {
  const block = document.getElementById('server-code');
  if (block && block.dataset.serverId === serverId) return block.textContent;

  const response = await fetch('/servers/' + serverId + '/' + fileName);
  if (!response.ok) throw new Error('could not read the server file: ' + response.status);
  return stripFrontMatter(await response.text());
}

// Restores a button to its previous look after the success state.
function restoreButton(button, content, className) {
  setTimeout(() => {
    button.innerHTML = content;
    button.className = className;
    button.style.backgroundColor = '';
    button.style.color = '';
    button.style.borderColor = '';
  }, 2000);
}

// Copy code functionality for small buttons (cards, small copy buttons)
window.copyServerCode = async function(serverId, fileName, buttonElement) {
  if (!buttonElement) return;

  try {
    const code = await serverCodeFor(serverId, fileName);
    await navigator.clipboard.writeText(code);

    const originalContent = buttonElement.innerHTML;

    buttonElement.innerHTML = `
      <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
      </svg>
      Copied!
    `;

    // Just add green background without changing anything else
    buttonElement.style.backgroundColor = '#16a34a';
    buttonElement.style.color = 'white';
    buttonElement.style.borderColor = '#16a34a';

    restoreButton(buttonElement, originalContent, buttonElement.className);
  } catch (err) {
    console.error('Failed to copy: ', err);
  }
};

// Copy code functionality for large buttons (server page main copy button)
window.copyServerCodeLarge = async function(serverId, fileName, buttonElement) {
  if (!buttonElement) return;

  try {
    const code = await serverCodeFor(serverId, fileName);
    await navigator.clipboard.writeText(code);

    const originalContent = buttonElement.innerHTML;
    const originalClasses = buttonElement.className;

    buttonElement.innerHTML = `
      <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
      </svg>
      Copied!
    `;

    buttonElement.className = originalClasses
      .replace(/bg-\w+(-\w+)?/g, 'bg-green-600')
      .replace(/hover:bg-\w+(-\w+)?/g, 'hover:bg-green-700')
      .replace(/text-\w+(-\w+)?/g, 'text-white');

    restoreButton(buttonElement, originalContent, originalClasses);
  } catch (err) {
    console.error('Failed to copy: ', err);
  }
};

// Download server file functionality. The downloaded file carries no front matter, which
// is what the page shows. An agent that wants the catalog file whole reads
// /servers/{id}/{name} instead.
window.downloadServerFile = async function(serverId, fileName, buttonElement) {
  if (!buttonElement) return;

  try {
    const code = await serverCodeFor(serverId, fileName);

    const blob = new Blob([code], { type: 'text/plain' });
    const url = window.URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = fileName;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    window.URL.revokeObjectURL(url);

    const originalText = buttonElement.innerHTML;
    const originalClasses = buttonElement.className;

    // Change button to success state
    buttonElement.innerHTML = `
      <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
      </svg>
      Downloaded!
    `;
    buttonElement.className = 'inline-flex items-center px-4 py-2 bg-green-600 text-white rounded-md hover:bg-green-700 transition-colors';

    restoreButton(buttonElement, originalText, originalClasses);
  } catch (err) {
    console.error('Failed to download: ', err);
  }
};

// Copies the agent prompt that the button carries in its data-prompt attribute. The text
// never enters the onclick attribute, so a quote in it cannot break the markup: Nunjucks
// escapes the attribute on the way in, and dataset decodes it back.
window.copyPrompt = function(buttonElement) {
  const prompt = buttonElement && buttonElement.dataset.prompt;
  if (!prompt) return;

  navigator.clipboard.writeText(prompt).then(function() {
    const originalContent = buttonElement.innerHTML;
    const originalClasses = buttonElement.className;

    buttonElement.innerHTML = `
      <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
      </svg>
      Prompt copied!
    `;

    buttonElement.style.backgroundColor = '#16a34a';
    buttonElement.style.color = 'white';
    buttonElement.style.borderColor = '#16a34a';

    restoreButton(buttonElement, originalContent, originalClasses);
  }).catch(function(err) {
    console.error('Failed to copy: ', err);
  });
};
</script>
